{
  "version": 2,
  "builds": [
    {
      "src": "api/feedbacks.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "routes": [
    {
      "src": "/api/feedbacks",
      "dest": "/api/feedbacks"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}